# Настройки бэкенда. На сервере файл лежит как /opt/workout/.env
# и подключается systemd через EnvironmentFile.

# Обязательный. Им же подписываются JWT: смена ключа разлогинит всех.
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку

# В работе всегда False: при True Django отдаёт трейсбеки с путями и данными
DJANGO_DEBUG=False

DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=https://workout.itnog.ru

# По этому поясу считаются "сегодня" и "текущий месяц"; по умолчанию Europe/Moscow
# DJANGO_TIME_ZONE=Europe/Moscow
